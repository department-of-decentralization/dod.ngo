{
  "name": "tailwind-nextjs-starter-blog",
  "version": "2.2.0",
  "private": true,
  "scripts": {
    "start": "next dev --webpack",
    "dev": "cross-env INIT_CWD=$PWD next dev --webpack",
    "build": "cross-env INIT_CWD=$PWD next build --webpack && cross-env NODE_OPTIONS='--experimental-json-modules' node ./scripts/postbuild.mjs",
    "serve": "next start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "analyze": "cross-env ANALYZE=true next build --webpack",
    "lint": "eslint --fix app components lib layouts scripts",
    "prepare": "husky"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@next/bundle-analyzer": "16.3.6",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.12",
    "body-scroll-lock": "^4.0.0-beta.0",
    "contentlayer2": "0.5.8",
    "esbuild": "0.28.2",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.2",
    "hast-util-from-html-isomorphic": "^2.0.0",
    "next": "16.3.6",
    "next-contentlayer2": "0.5.8",
    "next-themes": "^0.4.6",
    "pliny": "0.4.1",
    "postcss": "^8.4.24",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-citation": "^2.0.0",
    "rehype-katex": "^7.0.0",
    "rehype-preset-minify": "7.0.1",
    "rehype-prism-plus": "^2.0.0",
    "rehype-slug": "^6.0.0",
    "remark": "^15.0.0",
    "remark-gfm": "^4.0.0",
    "remark-github-blockquote-alert": "^2.1.0",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "unist-util-visit": "^5.0.0",
    "yet-another-react-lightbox": "3.32.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@svgr/webpack": "^8.0.1",
    "@types/eslint-plugin-jsx-a11y": "^6",
    "@types/mdx": "^2.0.12",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "5.0.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.0.0",
    "globals": "^17.12.0",
    "husky": "^9.0.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.0.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx)": [
      "eslint --fix"
    ],
    "*.+(js|jsx|ts|tsx|json|css|md|mdx)": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@4.18.1"
}
